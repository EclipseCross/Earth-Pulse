# Data mode: "live" (earthaccess/CMR) or "demo" (preprocessed files in backend/demo_data)
EARTHPULSE_MODE=live
AI_API_KEY=
DATABASE_URL=postgresql://earthpulse:earthpulse@localhost:5432/earthpulse
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# NISAR collection short names are auto-discovered from NASA's catalog (matched by title).
# Only set these to override discovery (comma-separated allowed). Check GET /api/nisar/resolved
NISAR_SHORTNAME_GUNW=
NISAR_SHORTNAME_GSLC=
NISAR_SHORTNAME_GCOV=
NISAR_SHORTNAME_GOFF=
NISAR_SHORTNAME_SME2=

# Watcher: minutes between automatic checks for new observations (0 = off)
WATCH_INTERVAL_MINUTES=180
SEARCH_CACHE_SECONDS=600

# Ground-deformation screening defaults. These are configurable research
# thresholds, not NASA or engineering risk ratings.
COHERENCE_THRESHOLD=0.5
MIN_VALID_FRACTION=0.1
DISPLACEMENT_THRESHOLD_MM=10
MIN_ZONE_AREA_KM2=0.01
REFERENCE_METHOD=median_high_coherence
REQUIRE_MAIN_COMPONENT=true
MAX_PROCESSING_PIXELS=2000000
